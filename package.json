{
  "name": "open-drama",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @open-drama/api dev\" \"pnpm --filter @open-drama/web dev\"",
    "build": "pnpm -r build",
    "start": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @open-drama/api start\" \"pnpm --filter @open-drama/web start\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
