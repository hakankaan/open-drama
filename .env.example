# Every value has a default; local development needs no .env at all.

# API
PORT=4000
# Keep the API on localhost: only the web port is meant to be exposed (adr-0010).
HOST=127.0.0.1
# Data root: SQLite file, media and the writable agent workspace. Defaults to <repo>/data.
# OPEN_DRAMA_DATA_DIR=/var/lib/open-drama
# SQLITE_PATH=
# STORAGE_PATH=
# WORKSPACE_PATH=
# Only needed when a video provider must fetch a local reference video or audio file.
# PUBLIC_BASE_URL=https://drama.example.com
# Names besides localhost and IP addresses that Open Drama answers to (both servers read it), comma-separated:
# set it to open the app by a LAN name or through a reverse proxy's domain.
# OPEN_DRAMA_ALLOWED_HOSTS=studio.lan,drama.example.com
# Override the bundled FFmpeg binaries.
# FFMPEG_BIN=
# FFPROBE_BIN=
# 1 registers offline stub adapters for image and video generation.
# OPEN_DRAMA_STUB_PROVIDERS=1
# Pause (ms) before every stub text reply, to watch running states and races by hand. 0 to 600000.
# OPEN_DRAMA_STUB_DELAY_MS=0
# Shot videos one episode generates at once; more requests wait for a free slot. 1 to 32.
# OPEN_DRAMA_VIDEO_CONCURRENCY=4
LOG_LEVEL=info

# AI assistants (adr-0016). The API serves MCP at POST /mcp for Claude Code, Claude Desktop, Cursor and the like.
# 0 turns the endpoint off (404).
# OPEN_DRAMA_ASSISTANT=1
# The bearer token assistants send (32+ characters). Unset, the server generates one at first start, prints it once
# and shows it in Settings › Assistant and at GET /api/v1/settings/assistant.
# OPEN_DRAMA_ASSISTANT_TOKEN=
# 0 = API only: no web studio runs; set HOST=0.0.0.0 and the port to publish yourself (Docker does it for you).
# OPEN_DRAMA_WEB_UI=1
# One ModelRunner key seeds a text, an image and a video service at start when none of that type is usable.
# Insert-only: a service you changed is never overwritten. The alternative is the studio, or the PATCH an assistant
# shows you, which reads the key from your terminal.
# OPEN_DRAMA_MODELRUNNER_API_KEY=

# Web
WEB_PORT=3000
# Where the web server forwards /api and /static. Read at request time.
API_ORIGIN=http://localhost:4000
